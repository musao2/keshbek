# KeshBak — Frontend .env namunasi
# Bu faylni nusxa olib .env nomi bilan saqlang va qiymatlarni to'ldiring
# HECH QACHON haqiqiy URL yoki kalitlarni bu faylga yozmang!

# Backend API asosiy manzili
VITE_API_URL=https://api.keshbak.uz/api/v1

# API so'rovlari uchun maksimal kutish vaqti (millisekund)
# 10000 = 10 soniya
VITE_API_TIMEOUT=10000

# Muhit nomi: development | staging | production
VITE_ENVIRONMENT=development
